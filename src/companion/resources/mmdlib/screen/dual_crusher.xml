<screen xmlns="https://moddev.zone/mmdlib/screen" title="block.mmdlib_companion.dual_crusher" title-fallback="Dual Crusher"
        block-entity="zone.moddev.mc.companion.ProcessorEntity">
  <vbox padding="7" spacing="4">
    <hbox spacing="6" align="center">
      <spacer/>
      <slot id="input" index="0"/>
      <vbox spacing="4">
        <hbox spacing="4" align="center">
          <label text="screen.mmdlib_companion.lane_a" text-fallback="Lane A"/>
          <progress id="progress" value="#getProgress" max="#getTime" jei-recipes="mmdlib_companion:crushing"/>
        </hbox>
        <hbox spacing="4" align="center">
          <label text="screen.mmdlib_companion.lane_b" text-fallback="Lane B"/>
          <progress id="second_progress" value="#getSecondProgress" max="#getSecondTime"/>
        </hbox>
      </vbox>
      <slot id="output" index="1"/>
      <spacer/>
      <energy-gauge id="energy" length="3s"/>
    </hbox>
    <hbox id="controls" spacing="2" align="center">
      <spacer/>
      <button flat="true" id="redstone" value="#getRedstoneMode" on-click="mmdlib_companion:redstone"
              icons="mmdlib:icon_redstone_ignore mmdlib:icon_redstone_high mmdlib:icon_redstone_low"
              value-labels="screen.mmdlib_companion.redstone.ignore screen.mmdlib_companion.redstone.high screen.mmdlib_companion.redstone.low"
              tooltip="screen.mmdlib_companion.redstone.tip"/>
      <button flat="true" id="toggle_0" value="#getPaused" on-click="mmdlib_companion:toggle_0"
              icons="mmdlib:icon_pause_a mmdlib:icon_resume_a"
              value-labels="screen.mmdlib_companion.pause.off screen.mmdlib_companion.pause.on"
              tooltip="screen.mmdlib_companion.pause.a.tip"/>
      <button flat="true" id="toggle_1" value="#getSecondPaused" on-click="mmdlib_companion:toggle_1"
              icons="mmdlib:icon_pause_b mmdlib:icon_resume_b"
              value-labels="screen.mmdlib_companion.pause.off screen.mmdlib_companion.pause.on"
              tooltip="screen.mmdlib_companion.pause.b.tip"/>
    </hbox>
  </vbox>
  <popout id="info" kind="info" edge="left" text="screen.mmdlib_companion.info.dual_crusher" value="#getWarnings"/>
</screen>
