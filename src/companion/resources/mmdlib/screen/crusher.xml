<screen xmlns="https://moddev.zone/mmdlib/screen" title="block.mmdlib_companion.crusher" title-fallback="Crusher"
        block-entity="zone.moddev.mc.companion.ProcessorEntity" extends="mmdlib:base_powered_machine">
  <fill name="body">
    <vbox padding="7" spacing="4">
      <context id="panel">
        <view id="machine">
          <hbox spacing="6" align="center">
            <fluid-tank tank="0" id="tank" length="3s"
                   tooltip="screen.mmdlib_companion.tank.tip" tooltip-fallback="Water or lava: {value} / {max} mB. Left-click to fill; right-click to drain with a fluid container."/>
            <spacer/>
            <inventory storage="input"><item-slot id="input" index="0"/></inventory>
            <custom id="progress" type="mmdlib_companion:progress_dial" width="24" height="24"
                    value="#getProgress" max="#getTime"
                    on-click="mmdlib_companion:toggle_0"
                    tooltip="screen.mmdlib_companion.progress_dial"
                    tooltip-fallback="Progress: {value} / {max} ticks. Click to pause or resume.">
              <property name="color" value="#55CC88"/>
            </custom>
            <hbox spacing="2">
              <inventory storage="output"><item-slot id="output" index="0"/></inventory>
              <slot id="output_2" index="2"/>
            </hbox>
            <spacer/>
            <energy-gauge id="energy" length="3s"/>
          </hbox>
          <hbox id="controls" spacing="2" align="center">
            <button text="screen.mmdlib_companion.recipes" text-fallback="Recipes"
                    tooltip="screen.mmdlib_companion.recipes.tip" tooltip-fallback="Show crushing recipes in JEI, when installed."
                    jei-recipes="mmdlib_companion:crushing"/>
            <button id="open_settings" text="screen.mmdlib_companion.settings" text-fallback="Settings"
                    tooltip="screen.mmdlib_companion.settings.tip" tooltip-fallback="Edit the machine name, energy reserve and lane state."
                    shows="panel:settings"/>
            <spacer/>
          </hbox>
        </view>
        <view id="settings" title="screen.mmdlib_companion.settings" title-fallback="Settings">
          <label text="screen.mmdlib_companion.name" text-fallback="Machine name"/>
          <custom id="name_editor" type="mmdlib_companion:name_editor" width="162" height="42"
                  value="#getMachineName"/>
          <custom id="reserve_slider" type="mmdlib_companion:reserve_slider" width="162" height="30"
                  value="#getReservePercent"/>
          <custom id="lane_selector" type="mmdlib_companion:lane_selector" width="162" height="30"
                  value="#getPaused">
            <property name="lane" value="0"/>
          </custom>
        </view>
      </context>
    </vbox>
  </fill>
</screen>
