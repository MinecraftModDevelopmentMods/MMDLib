<screen xmlns="https://moddev.zone/mmdlib/screen" title="block.mmdlib_companion.crusher" title-fallback="Crusher"
        block-entity="zone.moddev.mc.companion.ProcessorEntity">
  <vbox padding="7" spacing="4">
    <hbox spacing="6" align="center">
      <gauge id="tank" length="3s" value="#getTankFluid" max="#getTankCapacity"
             tooltip="screen.mmdlib_companion.tank.tip" tooltip-fallback="Water or lava: {value} / {max} mB. Click with a fluid container to transfer."
             on-click="mmdlib_companion:tank_container" on-right-click="mmdlib_companion:tank_container"/>
      <spacer/>
      <slot index="0"/>
      <progress id="progress" value="#getProgress" max="#getTime" jei-recipes="mmdlib_companion:crushing"/>
      <slot index="1"/>
      <spacer/>
      <energy-gauge id="energy" length="3s"/>
    </hbox>
    <checkbox value="#getPaused" id="toggle_0" text="screen.mmdlib_companion.toggle" text-fallback="Paused (free items)" tooltip="screen.mmdlib_companion.toggle.tip" tooltip-fallback="Pause this lane to free its reserved items, or resume it." on-click="mmdlib_companion:toggle_0"/>
  </vbox>
  <popout id="info" kind="info" edge="left" text="screen.mmdlib_companion.info.crusher" value="#getWarnings"/>
</screen>
